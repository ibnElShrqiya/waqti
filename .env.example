# WAQTI environment variables (copy to .env.local)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets (AI provider keys, service-role keys) in VITE_ variables.

# Data source for the frontend: "mock" (Phase 1 default) | "supabase" (Phase 2+)
VITE_DATA_SOURCE=mock

# Supabase public project settings (Phase 2+). Leave empty until a project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Web Push VAPID public key (Phase 4). Private VAPID & AI provider keys stay server-side only.
VITE_VAPID_PUBLIC_KEY=
